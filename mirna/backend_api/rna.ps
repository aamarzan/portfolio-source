[76.36135101 38.81893158]
[71.57183075 24.60413361]
[60.78453445 11.52473450]
[70.36656952 -2.46172357]
[86.45899963 2.87400079]
[85.78662872 19.81460953]
[90.57614899 34.02940750]
[95.36566925 48.24420547]
[101.04905701 54.14239883]
[99.81311035 64.26242065]
[103.03766632 78.91172791]
[114.91845703 84.78874969]
[121.02525330 96.55308533]
[118.99449921 109.65150452]
[109.61216736 119.01443481]
[111.23395538 133.92649841]
[112.85573578 148.83857727]
[114.47752380 163.75064087]
[118.73762512 182.65835571]
] def
/arcs [
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
[]
] def
/pairs [
[1 27]
[2 26]
[3 25]
[4 24]
[7 20]
[8 19]
[9 17]
[10 16]
[11 15]
] def

init

% switch off outline pairs or bases by removing these lines
drawoutline
drawpairs
drawbases
showpage
end
%%EOF
